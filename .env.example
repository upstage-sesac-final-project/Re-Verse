# Re:Verse Backend Environment Variables

# App Settings
ENVIRONMENT=development
DEBUG=True

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","https://*.vercel.app"]

# LLM 설정 (Solar, OpenAI, vLLM 등 OpenAI 호환 API 모두 지원)
# base_url 비우면 공식 OpenAI 엔드포인트 사용
# Solar 사용 시: LLM_BASE_URL=https://api.upstage.ai/v1, LLM_MODEL=solar-pro
# OpenAI 사용 시: LLM_BASE_URL= (비움), LLM_MODEL=gpt-4o
LLM_API_KEY=your_LLM_api_key
LLM_MODEL=solar-pro3
LLM_BASE_URL=https://api.upstage.ai/v1

# LangSmith (Monitoring)
LANGSMITH_API_KEY=input_your_langsmith_api_key
LANGSMITH_PROJECT=Re-Verse_project
LANGSMITH_TRACING=True

# Storage
STORAGE_PATH=./storage/games

# Agent Settings
AGENT_TIMEOUT=30
MAX_RETRIES=3

# Frontend (VITE_ prefix 필수)
VITE_API_URL=/api
VITE_USE_MOCK=False

DATABASE_URL=postgresql+psycopg:your_database_url

AWS_REGION=aws_region
AWS_S3_BUCKET_NAME=yout_bucket_name

S3_PREFIX=games
