# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── CORS ─────────────────────────────────────────────────────
# 쉼표 구분 또는 JSON 배열 형식 지원
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://re-verse.ai.kr,https://www.re-verse.ai.kr

# ── Database ─────────────────────────────────────────────────
# 개발: sqlite+aiosqlite:///./storage/reverse.db
# 프로덕션: postgresql+psycopg://USER:PASS@HOSTNAME:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./storage/reverse.db

# ── JWT / Auth ───────────────────────────────────────────────
JWT_SECRET_KEY=                        # 필수 — 비어 있으면 서버 시작 차단
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30              # Access Token 유효 시간 (분)
REFRESH_TOKEN_EXPIRATION_HOURS=24      # Refresh Token 유효 시간 (시간)

# ── 게임 파일 저장 ────────────────────────────────────────────
# 로컬 개발: ./storage/games
# 프로덕션(EC2): /app/storage/games 등 절대 경로 권장
STORAGE_PATH=./storage/games
BASE_GAME_PATH=./storage/games/base_game
STORAGE_BACKEND=local                  # local | s3
MAX_PROJECTS_PER_USER=3

# ── MCP (RPG Maker MZ stdio server) ──────────────────────────
# 4단계 Executor가 stdio MCP 서버(Node)를 서브프로세스로 실행할 때 사용.
# - 로컬(맥): MCP_NODE_SERVER_PATH는 호스트 절대 경로(예: /Users/you/.../dist/index.js)
# - Docker(EC2): 이미지에 포함된 경로(기본: /app/mcp-server/dist/index.js)
MCP_ENABLED=true

# 로컬로 실행할 경우 아래 주석 해제
# MCP_NODE_SERVER_PATH=C:\Users\yebin\Desktop\-rpgmaker-mz-mcp\dist\index.js
# MCP_CWD=C:\Users\yebin\Desktop\-rpgmaker-mz-mcp

# 도커로 실행할 경우 아래 주석 해제
MCP_NODE_SERVER_PATH=/app/mcp-server/dist/index.js
MCP_CWD=/app/mcp-server

# (선택) 기본은 targetDir. MCP 서버가 요구하는 경로 인자 키로 변경.
MCP_PATH_ARG_NAME=targetDir

# (선택) 초 단위 타임아웃
# MCP_TIMEOUT=30

# ── AWS S3 (EC2 IAM 역할 사용 시 ACCESS_KEY 불필요) ───────────
AWS_REGION=us-east-1
S3_BUCKET_NAME=upstage-sesac-31-reverse-project-s3
S3_PREFIX=games                        # 버킷 내 prefix (games/game_001/data/...)

# ── LLM ──────────────────────────────────────────────────────
LLM_API_KEY=                           # Upstage / OpenAI API Key
LLM_MODEL=solar-pro3
LLM_BASE_URL=https://api.upstage.ai/v1 # 비우면 OpenAI 공식 엔드포인트 사용
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_PARALLEL_TOOL_CALLS=false          # Solar API 호환성을 위해 false 권장

# ── Agent 동작 ────────────────────────────────────────────────
AGENT_TIMEOUT=60                       # Agent 최대 대기 시간 (초)
MAX_RETRIES=3

# ── LangSmith ─────────────────────────────────────────────────
LANGSMITH_API_KEY=                     # 비워두면 트레이싱 비활성화
LANGSMITH_PROJECT=Re-Verse
LANGSMITH_TRACING=false

#── admin_page ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@gmail.com

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=DEBUG                        # DEBUG | INFO | WARNING | ERROR (미설정 시 DEBUG/ENVIRONMENT로 자동 결정)
LOG_DIR=./logs                         # 로그 파일 저장 경로
LOG_LEVEL_SQLALCHEMY=WARNING           # SQLAlchemy 로거 레벨 오버라이드
LOG_LEVEL_HTTPX=WARNING                # HTTPX 로거 레벨 오버라이드

#── Frontend (VITE prefix 필수) ────────────────────────────────
VITE_API_URL=/api
VITE_USE_MOCK=False

# Vite 개발 서버 전용 (npm run dev, app/frontend 디렉터리). API·/game 프록시 타깃.
# 비우면 기본 http://127.0.0.1:8000 (백엔드를 호스트에서 띄우거나 도커 8000 포트 개방 시).
# docker compose --profile full-dev 로 프론트 컨테이너를 쓸 때는 compose가 http://backend:8000 을 넣음.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
