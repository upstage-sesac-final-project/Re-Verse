# EC2 호스트에서 scripts/ec2_host_monitor.sh 가 source 하는 설정 예시.
# 사용법: 복사 후 monitor.env 로 저장하고 값만 채운 뒤 chmod 600 권장.
#
#   cp monitor.env.example ~/.config/re-verse/monitor.env
#   vi ~/.config/re-verse/monitor.env
#
# Discord: 서버 모니터링 전용 채널 웹훅 (에러/토큰 알림과 분리 권장)
DISCORD_INFRA_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# 선택: 기본값은 각각 80, 0.90
# DISK_THRESHOLD=80
# LOAD_FACTOR=0.90
